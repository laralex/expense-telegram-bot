BOT_TOKEN=your_token_here
# Comma-separated Telegram user IDs allowed to use the bot.
# Each user gets a private data directory (data/<user_id>/) — data is never shared.
USER_IDS=123456789,987654321
USER_ID_OWNER=0

SERVICE_NAME="expense-telegram-bot"
DEPLOY_DIR="/opt/${SERVICE_NAME}"
BACKUP_DATA_DIR="/opt/${SERVICE_NAME}/data"
